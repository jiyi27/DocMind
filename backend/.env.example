# Logging
# LOG_DIR:   path to log directory (absolute or relative to project root)
# LOG_LEVEL: minimum level to write — debug | info | error
LOG_DIR=logs
LOG_LEVEL=INFO

# ── Optional Startup Overrides ───────────────────────────────────────────────
# DOCMIND_DB_PATH: Override the default SQLite path (<backend>/data/docmind.db).
# CORS_ORIGINS:    Comma-separated allowed origins. "*" allows all origins.
#                  Example: http://localhost:5173,https://app.example.com
# DOCMIND_DB_PATH=/absolute/path/to/docmind.db
CORS_ORIGINS=*

# ── JWT Authentication ──────────────────────────────────────────────────────
# JWT_SECRET_KEY:      A long random secret used to sign tokens.
#                      Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_ALGORITHM:       Signing algorithm. HS256 is the default and recommended for most cases.
# JWT_EXPIRE_MINUTES:  Token lifetime in minutes. 60 = 1 hour, 1440 = 1 day, 10080 = 1 week.
JWT_SECRET_KEY=change-me-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Super-admin Access Control ──────────────────────────────────────────────
# SUPER_ADMIN_USERNAMES: Comma-separated list of usernames that are granted
#   super-admin privileges.  Super-admins can perform privileged operations
#   such as creating and deleting knowledge bases.  Users must still log in
#   via JWT — this list only controls what they are allowed to do after login.
#   Leave empty (or omit) to disable super-admin access entirely.
#
#   Example:  SUPER_ADMIN_USERNAMES=super_admin,alice,bob
SUPER_ADMIN_USERNAMES=super_admin
