# Embedding (OpenAI-compatible — switch provider by changing the URL only)
# Ollama (local):   EMBEDDING_BASE_URL=http://localhost:11434/v1  EMBEDDING_API_KEY=ollama
# OpenAI:           EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBEDDING_API_KEY=sk-xxx
# OpenRouter:       EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text:latest

# Qdrant
# Note: QDRANT_COLLECTION is no longer used as the primary collection name.
# Collections are now created dynamically per knowledge base: docmind_{kb_name}
# e.g. "india" → "docmind_india", "pakistan" → "docmind_pakistan"
QDRANT_URL=http://localhost:6333

# LLM (OpenAI-compatible)
LLM_API_KEY=your-api-key-here
LLM_MODEL=google/gemini-3.1-flash-lite-preview
LLM_BASE_URL=https://openrouter.ai/api/v1

# Ingestion
CHUNK_SIZE=500
MAX_CHUNK_SIZE=1500
CHUNK_OVERLAP=50
# Whether to replace eligible fenced code blocks with an LLM-generated summary during ingestion.
ENABLE_CODE_SUMMARIZATION=false
# Image processing backend: "multimodal" | "ocr" | "none" (default: none)
#   multimodal — fetches the image and sends it to a vision-capable LLM for a text summary.
#   ocr        — fetches the image and extracts text via pytesseract (requires Tesseract on PATH
#                with the chi_sim language pack for Chinese support: sudo apt install tesseract-ocr-chi-sim).
#   none       — skips all image processing; image blocks are stored with alt-text only.
IMAGE_PROCESSOR=none
# Vision LLM — required only when IMAGE_PROCESSOR=multimodal
IMAGE_VISION_API_KEY=
IMAGE_VISION_MODEL=
IMAGE_VISION_BASE_URL=

# Retrieval
TOP_K=3                  # Vector retrieval top-k.
MAX_MESSAGES=20          # Max messages kept per session; oldest are dropped when exceeded.
MAX_FULL_DOCS=2          # Max full articles included in a single retrieval context (full_doc mode).
MAX_FULL_DOC_CHARS=50000 # Max characters per full article — enforced at upload and at retrieval truncation.

# Logging
# LOG_DIR:   path to log directory (absolute or relative to project root)
# LOG_LEVEL: minimum level to write — debug | info | error
LOG_DIR=logs
LOG_LEVEL=debug

# ── JWT Authentication ──────────────────────────────────────────────────────
# JWT_SECRET_KEY:      A long random secret used to sign tokens.
#                      Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_ALGORITHM:       Signing algorithm. HS256 is the default and recommended for most cases.
# JWT_EXPIRE_MINUTES:  Token lifetime in minutes. 60 = 1 hour, 1440 = 1 day, 10080 = 1 week.
JWT_SECRET_KEY=change-me-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Super-admin Access Control ──────────────────────────────────────────────
# SUPER_ADMIN_USERNAMES: Comma-separated list of usernames that are granted
#   super-admin privileges.  Super-admins can perform privileged operations
#   such as creating and deleting knowledge bases.  Users must still log in
#   via JWT — this list only controls what they are allowed to do after login.
#   Leave empty (or omit) to disable super-admin access entirely.
#
#   Example:  SUPER_ADMIN_USERNAMES=super_admin,alice,bob
SUPER_ADMIN_USERNAMES=super_admin
