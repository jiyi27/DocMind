# Embedding (OpenAI-compatible — switch provider by changing the URL only)
# Ollama (local):   EMBEDDING_BASE_URL=http://localhost:11434/v1  EMBEDDING_API_KEY=ollama
# OpenAI:           EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBEDDING_API_KEY=sk-xxx
# OpenRouter:       EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text:latest

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base

# LLM (OpenAI-compatible)
LLM_API_KEY=your-api-key-here
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# Ingestion
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=3

# Logging
# LOG_DIR:   path to log directory (absolute or relative to project root)
# LOG_LEVEL: minimum level to write — debug | info | error
LOG_DIR=logs
LOG_LEVEL=debug
